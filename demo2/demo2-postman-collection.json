    {
      "name": "1. RestTemplate 远程调用",
      "item": [
        {
          "name": "RestTemplate - GET 商品",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{cartBaseUrl}}/api/carts/rest/products/2001",
              "host": [
                "{{cartBaseUrl}}"
              ],
              "path": [
                "api",
                "carts",
                "rest",
                "products",
                "2001"
              ]
            },
            "description": "购物车服务通过 RestTemplate 调用商品服务 GET。"
          }
        },
        {
          "name": "RestTemplate - POST 新增商品",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"3001\",\n  \"name\": \"USB Cable\",\n  \"price\": 29.90\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{cartBaseUrl}}/api/carts/rest/products",
              "host": [
                "{{cartBaseUrl}}"
              ],
              "path": [
                "api",
                "carts",
                "rest",
                "products"
              ]
            },
            "description": "购物车服务通过 RestTemplate 调用商品服务 POST。"
          }
        },
        {
          "name": "RestTemplate - PUT 修改商品",
          "request": {
